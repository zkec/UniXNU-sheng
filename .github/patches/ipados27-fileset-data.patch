@@ -159,6 +159,23 @@ class Layout:
     def reserve(self, name, address):
         self.placements[name] = address
 
+    def place_data(self, old_info, code_end):
+        """Keep native writable data before retained kext data for arm_vm_init."""
+        data = self.roots['__DATA']
+        begin = data['va']
+        extra = align(max(0, self.span('__DATA') - self.room('__DATA', begin)))
+        if extra:
+            # The XML has a new mapping. Extend into its old trailing pages,
+            # keeping the existing data addresses and the end of the root fixed.
+            floor = align(max(old_info['va'], code_end))
+            if (old_info['va'] + old_info['size'] != begin
+                    or old_info['fileoff'] + old_info['filesize'] != data['fileoff']
+                    or begin - extra < floor):
+                raise ValueError(f'Native __DATA needs {extra:#x} extra bytes before retained kext data')
+            data.update(va=begin - extra, fileoff=data['fileoff'] - extra,
+                        size=data['size'] + extra, filesize=data['filesize'] + extra)
+        self.reserve('__DATA', data['va'])
+
     def span(self, name):
         """Bytes of a native segment in the collection: its size, or for __TEXT what the hole lets it map."""
         return self.mapped.get(name, self.segment(name)['size'])
