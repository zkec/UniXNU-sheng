+class DataPlacementTests(unittest.TestCase):
+    def layout(self, size):
+        layout = object.__new__(Layout)
+        layout.native = SimpleNamespace(segments=[dict(name='__DATA', size=size)])
+        layout.roots = {'__DATA': dict(va=0x80000, fileoff=0x40000, size=0x30000, filesize=0x30000)}
+        layout.occupied = [(0x98000, 0x98100)]
+        layout.placements, layout.mapped = {}, {}
+        return layout
+
+    def test_data_uses_only_the_pages_it_needs_from_relocated_metadata(self):
+        old_info = dict(va=0x70000, fileoff=0x30000, size=0x10000, filesize=0x10000)
+        for size, extra in ((0x18000, 0), (0x1c000, 0x4000)):
+            with self.subTest(size=size):
+                layout = self.layout(size)
+                layout.place_data(old_info, code_end=0x78000)
+                self.assertEqual(layout.roots['__DATA'], dict(va=0x80000 - extra, fileoff=0x40000 - extra,
+                                                            size=0x30000 + extra, filesize=0x30000 + extra))
+                self.assertEqual(layout.end('__DATA'), 0x98000)
+
+    def test_data_cannot_extend_into_code_or_across_a_gap(self):
+        old_info = dict(va=0x70000, fileoff=0x30000, size=0x10000, filesize=0x10000)
+        with self.assertRaisesRegex(ValueError, 'Native __DATA needs'):
+            self.layout(0x1c000).place_data(old_info, code_end=0x7c001)
+        with self.assertRaisesRegex(ValueError, 'Native __DATA needs'):
+            self.layout(0x1c000).place_data(dict(old_info, size=0xc000), code_end=0x78000)
+
+
 if __name__ == '__main__':
     unittest.main()
